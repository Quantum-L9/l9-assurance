{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quantum-l9.dev/assurance/v1/artifactreference.schema.json",
  "title": "ArtifactReference",
  "description": "ArtifactReference",
  "x-l9-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "$ref": "./digest.schema.json"
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "sdkVersion": {
      "type": "string",
      "description": "Semantic version of the L9 CI SDK that produced the referenced artifact. Provenance only: this is the version of the producing SDK for the artifact itself, not the producer identity of the enclosing observation.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"
    }
  },
  "required": [
    "name",
    "digest"
  ],
  "unevaluatedProperties": false
}
